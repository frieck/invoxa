{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoxa",
  "version": "0.1.0",
  "identifier": "com.invoxa.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Invoxa",
        "width": 1400,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "sql": {
      "preloadConnections": ["sqlite:invoices.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRkFDRTc0NTU5ODhFMzIKUldReWpwaFZkTTc2V3pGcTRLM09tRndDdHlIaTFvS1JDdkdjLzJwS1UyemxCaW5veEtPcDcyM2QK",
      "endpoints": [
        "https://github.com/frieck/invoxa/releases/latest/download/latest.json"
      ]
    }
  }
}
